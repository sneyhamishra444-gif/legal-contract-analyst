# ---------------------------------------------------------------------------
# AI provider (any OpenAI-compatible endpoint: OpenRouter, OpenAI, Together,
# Groq, or a local llama.cpp / Ollama server). All three values come from env.
# ---------------------------------------------------------------------------
LLM_API_KEY=
# OpenRouter example; swap for https://api.openai.com/v1 to use OpenAI directly.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
# Some providers (OpenRouter) like to know who is calling. Optional.
LLM_APP_URL=http://localhost:3000
LLM_APP_TITLE=Legal Contract Analyst

# Optional tuning
LLM_MAX_TOKENS=1200
LLM_TIMEOUT_MS=60000
AGENT_MAX_ROUNDS=6

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave EMPTY for local development: the app then uses SQLite (better-sqlite3),
# stored in ./.data/app.db — nothing to install and nothing to run. Set this to a
# hosted Postgres URL (Neon on Vercel) in production; the SQL is the same strings:
#   postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Comma-separated origins allowed to call the API (empty = same-origin only).
ALLOWED_ORIGINS=

# Optional: override where the local SQLite file lives.
# SQLITE_PATH=./.data/app.db
