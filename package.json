{
  "name": "legal-contract-analyst",
  "version": "1.0.0",
  "private": true,
  "description": "Upload legal contracts (PDF/DOCX), ask questions, get answers backed by quotes verified against the source text.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "fixtures": "node tools/make-fixtures.mjs",
    "shots": "node tools/demo-shots.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "mammoth": "^1.9.0",
    "next": "^15.5.0",
    "pg": "^8.13.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "unpdf": "^1.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.0",
    "jszip": "^3.10.2",
    "pdf-lib": "^1.17.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
